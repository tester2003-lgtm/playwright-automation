# Copy this file to ".env" and fill in the values. The real .env is git-ignored.

# Sites
BASE_URL=https://dev.singaprinting.com
ADMIN_URL=https://dev-admin-panel.singaprinting.com

# Customer member login (for logged-in specs)
MEMBER_EMAIL=
MEMBER_PASSWORD=

# Admin: 30-day "keep me signed in" token captured by hand
# (log in with the box ticked -> DevTools -> Cookies -> auth.remember_token). Renew ~monthly.
ADMIN_REMEMBER_TOKEN=

# Airwallex sandbox test card (for checkout specs)
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=
